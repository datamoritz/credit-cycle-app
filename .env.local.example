# ─── CreditCycle — Environment Variables ─────────────────────────────────────
#
# Copy this file to .env.local for local development.
# .env.local is gitignored and must never be committed.
#
# ─── Backend connection ───────────────────────────────────────────────────────

# URL of your Hetzner backend (no trailing slash).
# Leave unset (or comment out) to run in demo mode with local mock data.
BACKEND_URL=https://api.moritzknodler.com

# Shared secret between the Next.js frontend and the Hetzner backend.
# Must match API_SECRET on the backend exactly.
# Generate with: openssl rand -hex 32
API_SECRET=replace-with-a-strong-random-secret

# ─── NextAuth (Google OAuth) ──────────────────────────────────────────────────

# Random secret for signing sessions/JWTs.
# Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-a-strong-random-secret

# Google OAuth credentials — create at console.cloud.google.com
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# Full public URL of this deployment (no trailing slash).
# Vercel sets VERCEL_URL automatically; for local dev use http://localhost:3000
AUTH_URL=https://credit-cycle-app.moritzknodler.com
